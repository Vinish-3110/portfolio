# Common environment for Docker Compose.
# Copy to .env and fill in the database and admin password.
# DNS: vinishpurohit.in, www, and api.vinishpurohit.in.
# Admin panel: https://vinishpurohit.in/admin

DOMAIN=vinishpurohit.in
SITE_URL=https://vinishpurohit.in
API_PUBLIC_URL=https://api.vinishpurohit.in
ADMIN_URL=https://vinishpurohit.in/admin

# Backend. Paste the internal Postgres URL from Dokploy. Do not add a database container here.
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
PUBLIC_BASE_URL=https://api.vinishpurohit.in

# Frontend. These are baked in at image build time.
NEXT_PUBLIC_API_URL=https://api.vinishpurohit.in/api
NEXT_PUBLIC_SITE_URL=https://vinishpurohit.in
NEXT_PUBLIC_GA_ID=
